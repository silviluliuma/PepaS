#:kivy 2.2.0

<LoginScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 30
        spacing: 0
        canvas.before:
            Color:
                rgba: 0.96, 0.97, 0.99, 1
            Rectangle:
                pos: self.pos
                size: self.size
        
        # Header with improved logo
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: 120
            spacing: 0
            
            Image:
                source: "images/emojis/dog.png"
                size_hint_y: None
                height: 60
                allow_stretch: True
                keep_ratio: True
            
            Label:
                text: "Pepa$"
                font_size: '48sp'
                bold: True
                color: 0.2, 0.3, 0.6, 1
                size_hint_y: None
                height: 55
            
            Widget:
                size_hint_y: None
                height: 10
            
            Label:
                text: "Tu gestor de finanzas perruno"
                font_size: '16sp'
                color: 0.4, 0.4, 0.5, 1
                size_hint_y: None
                height: 30
        
        # Spacer
        Widget:
            size_hint_y: 0.4
        
        # Card for login form
        BoxLayout:
            orientation: 'vertical'
            spacing: 25
            padding: [30, 35, 30, 35]
            size_hint_x: 0.85
            pos_hint: {'center_x': 0.5}
            
            # Email
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: 90
                spacing: 12
                
                Label:
                    text: "Email"
                    font_size: '15sp'
                    bold: True
                    color: 0.2, 0.2, 0.3, 1
                    size_hint_y: None
                    height: 25
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                
                TextInput:
                    id: email
                    hint_text: "tu@email.com"
                    size_hint_y: None
                    height: 56
                    font_size: '16sp'
                    multiline: False
                    padding: [18, 16]
                    background_color: 0.98, 0.98, 0.99, 1
                    foreground_color: 0.15, 0.15, 0.25, 1
                    hint_text_color: 0.6, 0.6, 0.65, 1
                    cursor_color: 0.2, 0.6, 0.86, 1
            
            # Password
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: 90
                spacing: 12
                
                Label:
                    text: "Contraseña"
                    font_size: '15sp'
                    bold: True
                    color: 0.2, 0.2, 0.3, 1
                    size_hint_y: None
                    height: 25
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                
                TextInput:
                    id: password
                    hint_text: "Introduce tu contraseña"
                    password: True
                    size_hint_y: None
                    height: 56
                    font_size: '16sp'
                    multiline: False
                    padding: [18, 16]
                    background_color: 0.98, 0.98, 0.99, 1
                    foreground_color: 0.15, 0.15, 0.25, 1
                    hint_text_color: 0.6, 0.6, 0.65, 1
                    cursor_color: 0.2, 0.6, 0.86, 1
        
        # Feedback message
        Label:
            text: root.mensaje
            color: (0.2, 0.8, 0.3, 1) if "success" in root.mensaje or "correctly" in root.mensaje else (0.9, 0.2, 0.2, 1) #TODO MAKE THIS BETTER
            font_size: '15sp'
            bold: True
            size_hint_y: None
            height: 35
        
        # Spacer
        Widget:
            size_hint_y: 0.1
        
        # Spacer before buttons
        Widget:
            size_hint_y: None
            height: 20
        
        # Main login button
        Button:
            text: "¡Bienvenido de nuevo!"
            size_hint_y: None
            size_hint_x: 0.85
            height: 56
            font_size: '16sp'
            bold: True
            background_normal: ''
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            pos_hint: {'center_x': 0.5}
            on_release: root.login()
            canvas.before:
                Color:
                    rgba: 0.2, 0.6, 0.86, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14, 14, 14, 14]
        
        # Spacer between buttons
        Widget:
            size_hint_y: None
            height: 16
        
        # Secondary button
        Button:
            text: "¿Todavía no tienes una cuenta? Hazte una y deja que Pepa te aconseje"
            size_hint_y: None
            size_hint_x: 0.85
            height: 44
            font_size: '14sp'
            background_normal: ''
            background_color: 0, 0, 0, 0
            color: 0.5, 0.5, 0.6, 1
            pos_hint: {'center_x': 0.5}
            on_release: app.root.current = "new_user"
            canvas.before:
                Color:
                    rgba: 0.96, 0.97, 0.98, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12, 12, 12, 12]

<NewUserScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 40
        spacing: 20
        canvas.before:
            Color:
                rgba: 0.97, 0.97, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
        
        # Header with title and back button
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 60
            spacing: 15
            
            Button:
                text: "←"
                size_hint_x: None
                width: 60
                font_size: '28sp'
                bold: True
                background_normal: ''
                background_color: 0, 0, 0, 0
                color: 0.3, 0.3, 0.3, 1
                on_release: app.root.current = "login"
                canvas.before:
                    Color:
                        rgba: 0.9, 0.9, 0.9, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]
            
            BoxLayout:
                orientation: 'horizontal'
                spacing: 10
                
                Image:
                    source: "images/emojis/dog.png"
                    size_hint_x: None
                    width: 40
                    allow_stretch: True
                    keep_ratio: True
                
                Label:
                    text: "Crear nueva cuenta"
                    font_size: '26sp'
                    bold: True
                    color: 0.2, 0.3, 0.6, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
        
        Widget:
            size_hint_y: None
            height: 10
        
        # Card for registration form
        BoxLayout:
            orientation: 'vertical'
            spacing: 18
            padding: 25
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20, 20, 20, 20]
            
            # Full Name
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: 85
                spacing: 8
                
                Label:
                    text: "Nombre completo"
                    font_size: '16sp'
                    bold: True
                    color: 0.3, 0.3, 0.4, 1
                    size_hint_y: None
                    height: 30
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                
                TextInput:
                    id: name
                    hint_text: "Pepa Puente Martínez"
                    size_hint_y: None
                    height: 50
                    font_size: '18sp'
                    multiline: False
                    padding: [15, 12]
                    background_color: 1, 1, 1, 1
                    foreground_color: 0, 0, 0, 1
                    hint_text_color: 0.6, 0.6, 0.6, 1
                    cursor_color: 0, 0, 0, 1
            
            # Email
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: 85
                spacing: 8
                
                Label:
                    text: "Email"
                    font_size: '16sp'
                    bold: True
                    color: 0.3, 0.3, 0.4, 1
                    size_hint_y: None
                    height: 30
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                
                TextInput:
                    id: email
                    hint_text: "tu@email.com"
                    size_hint_y: None
                    height: 50
                    font_size: '18sp'
                    multiline: False
                    padding: [15, 12]
                    background_color: 1, 1, 1, 1
                    foreground_color: 0, 0, 0, 1
                    hint_text_color: 0.6, 0.6, 0.6, 1
                    cursor_color: 0, 0, 0, 1
            
            # Phone
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: 85
                spacing: 8
                
                Label:
                    text: "Teléfono"
                    font_size: '16sp'
                    bold: True
                    color: 0.3, 0.3, 0.4, 1
                    size_hint_y: None
                    height: 30
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                
                TextInput:
                    id: phone
                    hint_text: "+34123456789"
                    size_hint_y: None
                    height: 50
                    font_size: '18sp'
                    multiline: False
                    padding: [15, 12]
                    background_color: 1, 1, 1, 1
                    foreground_color: 0, 0, 0, 1
                    hint_text_color: 0.6, 0.6, 0.6, 1
                    cursor_color: 0, 0, 0, 1
            
            # Password
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: 85
                spacing: 8
                
                Label:
                    text: "Contraseña"
                    font_size: '16sp'
                    bold: True
                    color: 0.3, 0.3, 0.4, 1
                    size_hint_y: None
                    height: 30
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                
                TextInput:
                    id: password
                    hint_text: "Mínimo 6 caracteres"
                    password: True
                    size_hint_y: None
                    height: 50
                    font_size: '18sp'
                    multiline: False
                    padding: [15, 12]
                    background_color: 1, 1, 1, 1
                    foreground_color: 0, 0, 0, 1
                    hint_text_color: 0.6, 0.6, 0.6, 1
                    cursor_color: 0, 0, 0, 1
            
            # Confirm Password
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: 85
                spacing: 8
                
                Label:
                    text: "Repite la contraseña"
                    font_size: '16sp'
                    bold: True
                    color: 0.3, 0.3, 0.4, 1
                    size_hint_y: None
                    height: 30
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                
                TextInput:
                    id: confirm_password
                    hint_text: "Tu contraseña"
                    password: True
                    size_hint_y: None
                    height: 50
                    font_size: '18sp'
                    multiline: False
                    padding: [15, 12]
                    background_color: 1, 1, 1, 1
                    foreground_color: 0, 0, 0, 1
                    hint_text_color: 0.6, 0.6, 0.6, 1
                    cursor_color: 0, 0, 0, 1
        
        # Feedback message
        Label:
            text: root.mensaje
            color: (0.2, 0.8, 0.3, 1) if "success" in root.mensaje or "correctly" in root.mensaje else (0.9, 0.2, 0.2, 1)
            font_size: '15sp'
            bold: True
            size_hint_y: None
            height: 35
        
        # Spacer
        Widget:
            size_hint_y: 1
        
        # Create account button
        Button:
            size_hint_y: None
            height: 60
            background_normal: ''
            background_color: 0, 0, 0, 0
            on_release: root.create_account()
            canvas.before:
                Color:
                    rgba: 0.2, 0.7, 0.4, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15, 15, 15, 15]
            
            BoxLayout:
                orientation: 'horizontal'
                spacing: 10
                padding: [20, 0]
                
                Image:
                    source: "images/emojis/dog.png"
                    size_hint_x: None
                    width: 30
                    allow_stretch: True
                    keep_ratio: True
                
                Label:
                    text: "Crear nueva cuenta"
                    font_size: '20sp'
                    bold: True
                    color: 1, 1, 1, 1

<MenuScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 40
        spacing: 20
        canvas.before:
            Color:
                rgba: 0.97, 0.97, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
        
        # Top spacer
        Widget:
            size_hint_y: 0.3
        
        # Title
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: 150
            spacing: 0
            
            Image:
                source: "images/emojis/dog.png"
                size_hint_y: None
                height: 60
                allow_stretch: True
                keep_ratio: True
            
            Label:
                text: "Pepa$"
                font_size: '48sp'
                bold: True
                color: 0.2, 0.3, 0.6, 1
                size_hint_y: None
                height: 55
            
            Widget:
                size_hint_y: None
                height: 10
            
            Label:
                text: "Tu gestor de finanzas perruno"
                font_size: '16sp'
                color: 0.4, 0.4, 0.5, 1
                size_hint_y: None
                height: 25
        
        # Spacer
        Widget:
            size_hint_y: 0.2
        
        # Add transaction button
        Button:
            text: "Añadir gasto o ingreso"
            size_hint_y: None
            height: 65
            font_size: '20sp'
            bold: True
            background_normal: ''
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            on_release: app.root.current = "add_transaction"
            canvas.before:
                Color:
                    rgba: 0.2, 0.6, 0.86, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15, 15, 15, 15]
        
        # View transactions button
        Button:
            text: "Ver mi historial"
            size_hint_y: None
            height: 65
            font_size: '20sp'
            bold: True
            background_normal: ''
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            on_release: app.root.current = "see_history"
            canvas.before:
                Color:
                    rgba: 0.35, 0.7, 0.5, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15, 15, 15, 15]
        
        # Spacer
        Widget:
            size_hint_y: 1
        
        # Exit button
        Button:
            text: "Salir"
            size_hint_y: None
            height: 50
            font_size: '16sp'
            background_normal: ''
            background_color: 0, 0, 0, 0
            color: 0.5, 0.5, 0.5, 1
            on_release: app.stop()
            canvas.before:
                Color:
                    rgba: 0.95, 0.95, 0.95, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10, 10, 10, 10]

<AddTransactionScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 30
        spacing: 15
        canvas.before:
            Color:
                rgba: 0.97, 0.97, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
        
        # Header with title and back button
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 60
            spacing: 15
            
            Button:
                text: "←"
                size_hint_x: None
                width: 60
                font_size: '28sp'
                bold: True
                background_normal: ''
                background_color: 0, 0, 0, 0
                color: 0.3, 0.3, 0.3, 1
                on_release: app.root.current = "menu"
                canvas.before:
                    Color:
                        rgba: 0.9, 0.9, 0.9, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]
            
            BoxLayout:
                orientation: 'horizontal'
                spacing: 10
                
                Image:
                    source: "images/emojis/bone.png"
                    size_hint_x: None
                    width: 40
                    allow_stretch: True
                    keep_ratio: True
                
                Label:
                    text: "Nueva transacción"
                    font_size: '26sp'
                    bold: True
                    color: 0.2, 0.3, 0.6, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
        
        Widget:
            size_hint_y: None
            height: 10
        
        # Card for the form
        BoxLayout:
            orientation: 'vertical'
            spacing: 18
            padding: 25
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20, 20, 20, 20]
            
            # Transaction type
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: 85
                spacing: 8
                
                Label:
                    text: "Tipo de transacción"
                    font_size: '16sp'
                    bold: True
                    color: 0.3, 0.3, 0.4, 1
                    size_hint_y: None
                    height: 30
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                
                Spinner:
                    id: tipo
                    text: "GASTO"
                    values: ["GASTO", "INGRESO"]
                    size_hint_y: None
                    height: 50
                    font_size: '18sp'
                    background_normal: ''
                    background_color: 0, 0, 0, 0
                    color: 0.2, 0.2, 0.2, 1
                    canvas.before:
                        Color:
                            rgba: 0.95, 0.96, 0.98, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10, 10, 10, 10]
            
            # Amount
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: 85
                spacing: 8
                
                Label:
                    text: "Cantidad (€)"
                    font_size: '16sp'
                    bold: True
                    color: 0.3, 0.3, 0.4, 1
                    size_hint_y: None
                    height: 30
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                
                TextInput:
                    id: monto
                    hint_text: "2.50"
                    input_filter: "float"
                    size_hint_y: None
                    height: 50
                    font_size: '20sp'
                    multiline: False
                    padding: [15, 12]
                    background_color: 1, 1, 1, 1
                    foreground_color: 0, 0, 0, 1
                    hint_text_color: 0.6, 0.6, 0.6, 1
                    cursor_color: 0, 0, 0, 1
            
            # Description
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: 140
                spacing: 8
                
                Label:
                    text: "Descripción"
                    font_size: '16sp'
                    bold: True
                    color: 0.3, 0.3, 0.4, 1
                    size_hint_y: None
                    height: 30
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                
                TextInput:
                    id: descripcion
                    hint_text: "Chuches para Pepa, Veterinario de Pepa, Cama nueva para Pepa..."
                    size_hint_y: None
                    height: 100
                    font_size: '18sp'
                    multiline: True
                    padding: [15, 12]
                    background_color: 1, 1, 1, 1
                    foreground_color: 0, 0, 0, 1
                    hint_text_color: 0.6, 0.6, 0.6, 1
                    cursor_color: 0, 0, 0, 1
        
        # Feedback message
        Label:
            text: root.mensaje
            color: (0.2, 0.8, 0.3, 1) if "success" in root.mensaje or "correctly" in root.mensaje else (0.9, 0.2, 0.2, 1)
            font_size: '15sp'
            bold: True
            size_hint_y: None
            height: 35
        
        # Spacer
        Widget:
            size_hint_y: 1
        
        # Save button
        Button:
            size_hint_y: None
            height: 60
            background_normal: ''
            background_color: 0, 0, 0, 0
            on_release: root.guardar_transaccion()
            canvas.before:
                Color:
                    rgba: 0.2, 0.7, 0.4, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15, 15, 15, 15]
            
            BoxLayout:
                orientation: 'horizontal'
                spacing: 10
                padding: [20, 0]
                
                Image:
                    source: "images/emojis/save.png"
                    size_hint_x: None
                    width: 30
                    allow_stretch: True
                    keep_ratio: True
                
                Label:
                    text: "Guardar"
                    font_size: '20sp'
                    bold: True
                    color: 1, 1, 1, 1

<SeeHistoryScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 30
        spacing: 15
        canvas.before:
            Color:
                rgba: 0.97, 0.97, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
        
        # Header with title and back button
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 60
            spacing: 15
            
            Button:
                text: "←"
                size_hint_x: None
                width: 60
                font_size: '28sp'
                bold: True
                background_normal: ''
                background_color: 0, 0, 0, 0
                color: 0.3, 0.3, 0.3, 1
                on_release: app.root.current = "menu"
                canvas.before:
                    Color:
                        rgba: 0.9, 0.9, 0.9, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]
            
            BoxLayout:
                orientation: 'horizontal'
                spacing: 10
                
                Image:
                    source: "images/emojis/dog.png"
                    size_hint_x: None
                    width: 40
                    allow_stretch: True
                    keep_ratio: True
                
                Label:
                    text: "Mi Historial"
                    font_size: '26sp'
                    bold: True
                    color: 0.2, 0.3, 0.6, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
        
        Widget:
            size_hint_y: None
            height: 10
        
        # Placeholder for transactions list
        BoxLayout:
            orientation: 'vertical'
            spacing: 10
            padding: 20
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20, 20, 20, 20]
            
            Label:
                text: "Aquí aparecerá tu historial de transacciones"
                font_size: '18sp'
                color: 0.5, 0.5, 0.5, 1
                halign: 'center'
                valign: 'middle'
                text_size: self.size